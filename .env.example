# Reference environment for the whole repository.
# Copy into each component that needs it (as .env in llm-corpus-builder/ and
# academic-affairs-product/) and fill in your own values. Never commit .env.

# --- generation / judging endpoint (OpenAI-compatible) -------------------
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# --- local annotation model (build-time labels; needs no remote API) -----
LOCAL_ANNOTATE_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_ENDPOINT=https://hf-mirror.com

# --- retrieval runtime ---------------------------------------------------
BUILDER_URL=http://127.0.0.1:8772
PRODUCT_ARM=light
RETRIEVAL_TOP_K=10
PACK_LIMIT=8
REQUEST_TIMEOUT=90

# --- product service -----------------------------------------------------
PRODUCT_HOST=127.0.0.1
PRODUCT_PORT=8770
ASK_LOG=logs/ask.jsonl

# --- external baselines (only if you rerun the comparison) --------------
RAGFLOW_API=http://127.0.0.1:9380/api/v1
RAGFLOW_EMAIL=
RAGFLOW_PASSWORD=

# --- directory overrides (defaults assume sibling checkouts) ------------
# BUILDER_DIR=../llm-corpus-builder
# PROVIDER_DIR=../raw-material-provider
# CORPUS_DIR=../llm-corpus-builder/data/corpus
# INBOX_DIR=../raw-material-provider/inbox
