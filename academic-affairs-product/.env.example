# Product runtime configuration (P0).  Copy to .env and adjust.
# See docs/NEXT-PLAN-PRODUCT-MATURITY-2026-10-14.md §3 for the config matrix.

# --- retrieval runtime ---
BUILDER_URL=http://127.0.0.1:8772
# light = active_llm_validated_ir  (BM25 + Query IR, no online models)
# quality = active_llm_validated_ir_rr  (+ bge reranker; needs the local model)
PRODUCT_ARM=light
RETRIEVAL_TOP_K=10
PACK_LIMIT=8
REQUEST_TIMEOUT=90

# --- product service ---
PRODUCT_HOST=127.0.0.1
PRODUCT_PORT=8770
ASK_LOG=logs/ask.jsonl

# --- LLM provider (all three or none; none = deterministic evidence template) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
