# ---- API 后端（仅公开站点语料的探路阶段使用）----
# SharePoint（sharepoint 站点）语料永不发送到外部 API；正式实验全部本地模型重跑。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# ---- 本地标注模型（SharePoint 语料及正式实验）----
LOCAL_ANNOTATE_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_ENDPOINT=https://hf-mirror.com

# 允许走 API 探路的站点（逗号分隔；sharepoint 永不列入）
ANNOTATE_API_ALLOWED_SITES=zju,zjui,ugrs,grs,bksy,news
