# Retrieval runtime image — LIGHT arm (BM25 + Query IR, no torch).
# Serves data/corpus builds mounted at /data/corpus.  The quality arm
# (active_llm_validated_ir_rr) needs the local reranker model and torch;
# run it on the host or extend this image — do not silently swap in torch.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    jieba>=0.42 numpy scipy "fastapi>=0.115,<1" "uvicorn>=0.34,<1" "pydantic>=2.8,<3" "httpx>=0.28,<1" python-dotenv

WORKDIR /app
COPY runtime/ runtime/
COPY retrieve/ retrieve/
COPY evidence/ evidence/
COPY export/ export/
COPY annotate/ annotate/
COPY decision/ decision/
COPY curate/ curate/

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app PYTHONIOENCODING=utf-8
EXPOSE 8772
CMD ["python", "-m", "runtime.service", "--host", "0.0.0.0", "--port", "8772", \
     "--build", "/data/corpus", "--config", "active_llm_validated_ir", \
     "--log", "/data/service/answer_context.jsonl"]
